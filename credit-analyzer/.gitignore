# Never commit real consumer reports. Git history is permanent, and a credit
# report in a repo is a breach waiting for the repo to change visibility.
fixtures/*.PDF
fixtures/*.pdf
fixtures/*.xml
fixtures/*.txt
!fixtures/synthetic_*.txt
!fixtures/synthetic_*.xml

# Analysis output may contain consumer data.
out/
*.findings.json

__pycache__/
*.pyc
.venv/
.pytest_cache/

# Web front end runtime data — uploaded consumer reports live here.
credit-analyzer-data/
web/__pycache__/

# Browser build inputs and output. The pypdf wheel is a download cache and the
# Pyodide runtime comes from node_modules; neither belongs in the repo.
browser/.wheels/
browser/__pycache__/
