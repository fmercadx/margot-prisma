{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r credit-analyzer/requirements.txt"
  },
  "deploy": {
    "startCommand": "gunicorn --chdir credit-analyzer/web --workers 1 --threads 4 --timeout 120 --access-logfile - app:app",
    "healthcheckPath": "/login",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
