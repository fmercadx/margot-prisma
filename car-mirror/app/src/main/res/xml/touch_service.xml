<?xml version="1.0" encoding="utf-8"?>
<!--
    Touch control asks for the least it can: it performs gestures, and that is all. It cannot
    read window content, receives no accessibility events, and is not an accessibility tool.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/touch_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="1000" />
